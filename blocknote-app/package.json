{
  "name": "blocknote-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start:backend": "node --experimental-sqlite backend/src/app.js",
    "dev:backend": "nodemon --exec \"node --experimental-sqlite\" backend/src/app.js",
    "dev:frontend": "cd frontend && npm run dev",
    "test:api": "cross-env NODE_OPTIONS=--experimental-sqlite npx jest --runInBand --forceExit --testPathPattern=\"tests/api\"",
    "test:e2e": "npx playwright test",
    "test": "npm run test:api"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/api/**/*.test.js"
    ]
  }
}
